{
  "name": "prazo-claro",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.0.8",
  "engines": {
    "node": ">=22.14.0 <23"
  },
  "scripts": {
    "check": "pnpm typecheck && pnpm lint && pnpm format:check && pnpm test",
    "dev": "next dev --hostname 127.0.0.1",
    "build": "next build",
    "start": "next start --hostname 127.0.0.1",
    "typecheck": "tsc --noEmit",
    "lint": "eslint . --max-warnings 0",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:e2e": "playwright test",
    "format:check": "prettier --check src tests *.json *.ts *.mjs",
    "db:start": "supabase start",
    "db:reset": "supabase db reset",
    "db:test": "supabase test db",
    "db:test:auth": "node supabase/scripts/verify-local-isolation.mjs",
    "db:test:app": "node supabase/scripts/verify-local-app.mjs",
    "db:test:invite": "node supabase/scripts/verify-local-invite.mjs",
    "db:test:recovery": "node supabase/scripts/verify-local-recovery.mjs",
    "reminders:dispatch": "node --env-file=.env.local supabase/scripts/dispatch-local-reminders.mjs",
    "reminders:configure:local": "node supabase/scripts/configure-local-reminders.mjs",
    "db:test:reminders": "node --env-file=.env.local supabase/scripts/verify-local-reminders.mjs",
    "reminders:watch": "node --env-file=.env.local supabase/scripts/dispatch-local-reminders.mjs --watch",
    "reminders:check:brevo": "node --env-file=.env.reminders.external.local supabase/scripts/check-brevo-sandbox.mjs"
  },
  "dependencies": {
    "@hookform/resolvers": "5.9.2",
    "@js-temporal/polyfill": "0.5.1",
    "@radix-ui/react-slot": "1.5.0",
    "@supabase/ssr": "0.12.7",
    "@supabase/supabase-js": "2.118.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "1.59.0",
    "next": "16.4.2",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "react-hook-form": "7.90.0",
    "tailwind-merge": "3.7.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "braces": "3.0.3",
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "26.6.5",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.2",
    "fast-check": "4.10.2",
    "prettier": "3.9.10",
    "supabase": "2.121.0",
    "tailwindcss": "4.3.3",
    "typescript": "6.0.3",
    "vitest": "5.0.5"
  }
}
