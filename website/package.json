{
  "name": "prazo-claro-docs",
  "version": "1.0.0",
  "private": true,
  "engines": {
    "node": ">=22.14.0"
  },
  "scripts": {
    "prepare:content": "node scripts/prepare.mjs",
    "start": "npm run prepare:content && docusaurus start --host 127.0.0.1 --port 3001",
    "build": "npm run prepare:content && docusaurus build",
    "serve": "docusaurus serve --host 127.0.0.1 --port 3001",
    "test": "node --test tests/*.test.mjs",
    "verify:build": "node scripts/verify-build.mjs",
    "test:browser": "node scripts/browser-check.mjs"
  },
  "dependencies": {
    "@docusaurus/core": "3.10.2",
    "@docusaurus/preset-classic": "3.10.2",
    "@docusaurus/theme-mermaid": "3.10.2",
    "@easyops-cn/docusaurus-search-local": "0.55.3",
    "@mdx-js/react": "3.1.1",
    "@mermaid-js/layout-elk": "0.1.9",
    "clsx": "2.1.1",
    "prism-react-renderer": "2.4.1",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "cheerio": "1.1.2"
  }
}
