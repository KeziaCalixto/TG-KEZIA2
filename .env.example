NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Optional reminders. Never prefix these variables with NEXT_PUBLIC_.
# Keep REMINDERS_MODE empty to disable. Local mode uses loopback + Mailpit only.
REMINDERS_MODE=
REMINDERS_APP_URL=http://127.0.0.1:3000
REMINDERS_MAILPIT_URL=http://127.0.0.1:54324
REMINDERS_SUPABASE_SECRET_KEY=
REMINDERS_DISPATCH_SECRET=
# Dedicated HMAC key: Vault + production server only; never send as a header.
REMINDERS_SCHEDULER_SECRET=

# External adapter: configure only in Vercel production after migrations/checks.
# Requires REMINDERS_MODE=brevo, the canonical app/project URLs and explicit enable.
# The scheduler is a separate setup; these placeholders do not activate it.
REMINDERS_DELIVERY_ENABLED=
BREVO_API_KEY=
BREVO_SENDER_EMAIL=
BREVO_SENDER_NAME=Prazo Claro
